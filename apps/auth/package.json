{
	"name": "@jman.dev/auth",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"typecheck": "tsc -b",
		"cf-typegen": "wrangler types",
		"auth:generate": "auth generate --config auth.cli.ts --output src/worker/db/auth-schema.ts -y",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply auth --local",
		"db:migrate:remote": "wrangler d1 migrations apply auth --remote"
	},
	"dependencies": {
		"@better-auth/oauth-provider": "^1.7.7",
		"@better-auth/passkey": "^1.7.7",
		"@better-auth/utils": "0.4.2",
		"@better-fetch/fetch": "1.3.2",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.13",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.62.5",
		"@tanstack/router-plugin": "^1.168.42",
		"@tsconfig/strictest": "^2.0.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"auth": "^1.7.7",
		"drizzle-kit": "^0.31.11",
		"typescript": "^5.9.3",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	}
}
