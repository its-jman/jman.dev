{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jman-auth",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "auth.jman.dev", "custom_domain": true }],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/.well-known/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auth",
			// Replace with the id from `wrangler d1 create auth`
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://auth.jman.dev",
		"ALLOWED_EMAILS": "josh@jman.me",
		"ADMIN_EMAILS": "josh@jman.me"
	},
	// Secrets: BETTER_AUTH_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
	"observability": { "enabled": true }
}
