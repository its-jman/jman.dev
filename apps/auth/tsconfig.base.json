{
	"extends": "@tsconfig/strictest/tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"exactOptionalPropertyTypes": false,
		"noPropertyAccessFromIndexSignature": false
	}
}
